# Production settings (DD-232). Copy to .env next to docker-compose.yml and
# fill in; .env is git-ignored. Generate secrets on the host, e.g.:
#   openssl rand -base64 32      # JWT_PRIVATE_KEY_SEED
#   openssl rand -hex 24         # POSTGRES_PASSWORD, REDIS_PASSWORD

# Public hostname (DNS A/AAAA record → this host) and the e-mail Let's Encrypt
# uses for expiry notices.
DOMAIN=
ACME_EMAIL=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Token-signing key: changing it signs every player out.
JWT_PRIVATE_KEY_SEED=

# Browser origins allowed to call the API (Flutter web build), comma-separated.
CORS_ALLOWED_ORIGINS=

# Shown on /terms and /privacy (DD-231). Required before launch.
LEGAL_OPERATOR=
SUPPORT_EMAIL=

# Account e-mails (verification, password reset, deletion notices). Without
# SMTP_HOST outside dev, e-mails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Push notifications (optional until the Firebase/Apple accounts exist).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_SANDBOX=false

# Backups: where dumps go on the host, and for how many days they are kept
# (the privacy policy promises ≤ 35).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=35

# Monitoring + alert e-mails (DD-236): create alertmanager.yml from
# alertmanager.yml.example first, then uncomment.
# COMPOSE_PROFILES=monitoring
