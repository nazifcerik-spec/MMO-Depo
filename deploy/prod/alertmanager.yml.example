# Alert delivery (DD-236). Copy to alertmanager.yml (git-ignored: it holds
# the SMTP password) and set COMPOSE_PROFILES=monitoring in .env.
# Validate: scripts/check-alerts.sh deploy/prod/alertmanager.yml
#
# v1 delivers by e-mail. Slack/PagerDuty receivers (docs/infra/alerting.md
# §6) slot in as extra receivers once those accounts exist.
global:
  smtp_smarthost: smtp.example.com:587
  smtp_from: alerts@example.com
  smtp_auth_username: alerts@example.com
  smtp_auth_password: CHANGE_ME
  smtp_require_tls: true

route:
  receiver: ops-email
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="critical"']
      receiver: ops-email
      group_wait: 10s
      repeat_interval: 1h
    - matchers: ['severity="info"']
      receiver: "null"

receivers:
  - name: ops-email
    email_configs:
      - to: ops@example.com
        send_resolved: true
  - name: "null"

# The louder alert of a pair silences the quieter one.
inhibit_rules:
  - source_matchers: ['alertname="OtterHighErrorRate"']
    target_matchers: ['alertname="OtterElevatedErrorRate"']
  - source_matchers: ['alertname="OtterWorkerJobBroken"']
    target_matchers: ['alertname="OtterWorkerJobFailing"']
    equal: [job]
  - source_matchers: ['alertname="OtterInstanceDown"', 'job="otter-worker"']
    target_matchers: ['alertname=~"OtterWorkerJob.*"']
