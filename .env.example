# Otter — dev environment
# Copy to .env and adjust for local run.

ENV=dev
LOG_LEVEL=debug

# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s

# Postgres
DATABASE_URL=postgres://otter:otter@localhost:5432/otter?sslmode=disable
DATABASE_MAX_CONNS=25

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Content pack (Faz 01 ileride)
CONTENT_PATH=./content

# --- Auth (DD-189) ---
JWT_ISSUER=otter

# Base64-encoded 32-byte Ed25519 seed. LEAVE EMPTY IN DEV — server generates
# ephemeral key at boot and logs the seed (tokens invalidate on restart).
# In staging/prod set via secret manager (Vault / AWS SM).
# Generate a fresh seed:  openssl rand -base64 32
JWT_PRIVATE_KEY_SEED=

AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_SESSION_TTL=720h
AUTH_MIN_PASSWORD_LEN=8

# --- Character (DD-OPEN-8) ---
CHARACTER_SLOT_CAP=5
CHARACTER_DELETE_GRACE=48h

# --- Observability (Sprint 27, DD-214) ---
# /metrics on private ports; empty disables.
METRICS_ADDR=:9090
WORKER_METRICS_ADDR=:9091
# OTLP/HTTP collector base URL (e.g. http://localhost:4318). Empty = tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=1.0

# --- CORS (Sprint 28) — browser origins for Flutter web, comma-separated. ---
# Dev also allows any http://localhost:<port>. Never use *.
CORS_ALLOWED_ORIGINS=

# --- Client IP (DD-225) — LB / reverse proxy IPs or CIDRs whose X-Forwarded-For
# is trusted, comma-separated. Empty = peer address (API exposed directly).
# Set this behind a load balancer, or every player shares the LB's rate limits.
TRUSTED_PROXIES=

# --- Legal pages (DD-231): shown on /terms and /privacy. Empty = draft banner.
LEGAL_OPERATOR=
SUPPORT_EMAIL=

# --- Account recovery e-mail (Sprint 37, DD-219) ---
# Base URL of links in e-mails (host serving /verify-email and /reset-password).
PUBLIC_BASE_URL=http://localhost:8080
# true = characters need a verified e-mail (enable once SMTP works).
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Empty SMTP_HOST = mails are only logged (dev). Use a secret manager in prod.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
