# Copy to key.properties (git-ignored) to sign release builds (DD-233).
# Create the upload keystore once and keep it and its passwords safe — losing
# it means asking Google Play for an upload key reset:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
# storeFile is relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
